<idea-plugin>
    <id>com.github.juliarzymowska.aiconsoleexplainer</id>
    <name>AI Console Explainer</name>
    <vendor>juliarzymowska</vendor>
    <description><![CDATA[
        <p><b>AI Console Explainer</b> integrates LLMs directly into the IDE run console.</p>
        <p>Right-click any error message or stack trace to get an instant AI-generated explanation and suggested fix, streamlining the debugging process without leaving the IDE.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        </extensions>

    <actions>
        <action id="ConsoleAiExplainerAction"
                class="com.github.juliarzymowska.plugin.actions.ExplainErrorAction"
                text="Explain Error with AI"
                description="Sends selected console text to an LLM for analysis">
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>