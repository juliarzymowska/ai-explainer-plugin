<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.juliarzymowska.plugin.aiexplainer</id>
    <name>AI Console Explainer</name>
    <vendor email="juliarzymowska9@gmail.com" url="https://juliarzymowska.github.io/" >Julia Rzymowska</vendor>

    <description><![CDATA[
      An intelligent tool for analyzing console errors and stack traces with automated source code context injection.
    ]]></description>

    <!-- Indicates that this plugin requires the core platform and Java modules to function -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 1. Registration of the Settings Service (State) and its UI Configurable -->
        <applicationService serviceImplementation="com.github.juliarzymowska.plugin.settings.AiExplainerSettingsState"/>
        <applicationConfigurable parentId="tools" instance="com.github.juliarzymowska.plugin.settings.AiExplainerConfigurable"
                                 id="com.github.juliarzymowska.plugin.settings.AiExplainerConfigurable"
                                 displayName="AI Explainer"/>

        <!-- 2. Registration of the Tool Window (the panel at the bottom of the IDE) -->
        <toolWindow id="AI Explainer" secondary="true" anchor="bottom"
                    factoryClass="com.github.juliarzymowska.plugin.toolWindow.AiToolWindowFactory"/>
    </extensions>

    <!-- 3. Registration of the right-click context menu actions -->
    <actions>
        <action id="SendToAiAction"
                class="com.github.juliarzymowska.plugin.actions.SendToAiAction"
                text="AI Explainer: Analyze Error"
                description="Sends selected error and source code to the AI tool window">

            <!-- Adds the action to the Run/Terminal console context menu -->
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
            <!-- Adds the action to the standard code editor context menu -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>